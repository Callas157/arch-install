# Callas OS Plymouth
# A arte completa fica em background.jpg. Não desenhamos logo, texto ou barra
# adicionais por cima para que a tela exibida seja exatamente a arte do projeto.

Window.SetBackgroundTopColor(0.00, 0.00, 0.00);
Window.SetBackgroundBottomColor(0.00, 0.00, 0.00);

background_image = Image("background.jpg");
background_scaled = background_image.Scale(Window.GetWidth(), Window.GetHeight());
background = Sprite(background_scaled);
background.SetX(Window.GetX());
background.SetY(Window.GetY());

fun refresh_callback() {
    background.SetX(Window.GetX());
    background.SetY(Window.GetY());
}

Plymouth.SetRefreshFunction(refresh_callback);
